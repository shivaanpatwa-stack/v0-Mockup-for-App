# Copy to .env and edit. Restart `npx expo start` after changing it.

# Where the FastAPI backend is reachable FROM THE PHONE, e.g. your computer's LAN address.
# If unset, the app falls back to the Expo dev server's host on port 8000.
EXPO_PUBLIC_API_URL=http://192.168.1.5:8000

# Same CARTO basemap key the web app uses (NEXT_PUBLIC_CARTO_API_KEY). Optional: without it the map uses OSM tiles.
# EXPO_PUBLIC_CARTO_API_KEY=
